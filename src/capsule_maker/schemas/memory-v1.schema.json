{
  "type": "object",
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "origin": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "backend",
        "description"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "python": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "procedure",
              "test",
              "evidence",
              "instructions",
              "data"
            ]
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "path",
          "role",
          "packages"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "origin",
    "records",
    "sources",
    "python",
    "artifacts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "context",
            "decision",
            "correction",
            "failed_attempt",
            "result",
            "hypothesis",
            "question",
            "procedure",
            "evidence"
          ]
        },
        "status": {
          "enum": [
            "verified",
            "hypothesis",
            "unresolved",
            "superseded",
            "unverified"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "contradicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sensitive": {
          "type": "boolean"
        },
        "claim_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "content",
        "tags",
        "references",
        "evidence",
        "artifacts",
        "provenance",
        "supersedes",
        "contradicts",
        "sensitive"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "uri",
        "description"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "procedure",
            "test",
            "evidence",
            "instructions",
            "data",
            "summary"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "role",
        "sha256",
        "size"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "objective",
        "tags"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "python",
        "packages"
      ],
      "additionalProperties": false
    }
  }
}
